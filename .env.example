# Environment variables for lamazad.ge

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://lamazad.ge

# Database credentials (PostgreSQL)
POSTGRES_USER=lamazad_admin
POSTGRES_PASSWORD=your_ultra_secure_password_here_2026
POSTGRES_DB=lamazad_db

# Prisma connection string (used by Next.js app)
DATABASE_URL="postgresql://lamazad_admin:your_ultra_secure_password_here_2026@db:5432/lamazad_db?schema=public"

# Telemetry
NEXT_TELEMETRY_DISABLED=1
